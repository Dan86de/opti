{
  "name": "opti",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @opti/server dev",
    "repos:sync": "./scripts/repos-sync.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.38.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
