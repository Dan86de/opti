{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opti",
  "main": "src/index.ts",
  // ctx.exports loopback bindings - the gateway seam - are default-on from
  // compatibility date 2025-11-17, so they need no flag here.
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // The isolate. Worker Loader is open beta on the paid plan and is the most
  // load-bearing dependency in the system, which is why it is a recorded bet
  // with its own revisit trigger rather than an assumption.
  "worker_loaders": [{ "binding": "LOADER" }],

  // The in-worker compiler (in-worker-typescript, the publish pipeline)
  // probes bare Node builtins while its module initializes. These shims make
  // that init deterministic instead of depending on whatever workerd's
  // nodejs_compat stubs happen to do; vitest.workers.config.ts carries the
  // same map for the test pool, so local and production agree by
  // construction. The publish compile itself is virtual and touches none of
  // them. Only bare specifiers are remapped: `node:`-prefixed imports still
  // reach the real compat modules.
  "alias": {
    "fs": "./src/publish/node-shims/fs.ts",
    "os": "./src/publish/node-shims/os.ts",
    "path": "./src/publish/node-shims/path.ts",
    "perf_hooks": "./src/publish/node-shims/perf_hooks.ts",
    "inspector": "./src/publish/node-shims/inspector.ts",
    "crypto": "./src/publish/node-shims/crypto.ts"
  },

  // The same compiler init also reads the CommonJS `__filename`/`__dirname`
  // globals, which wrangler's esbuild leaves bare in a worker bundle - the
  // deployed publish died on "__filename is not defined" while the test
  // pool's optimizer injects its own shims, a recorded local/production
  // disagreement. The values are virtual: ts.sys only ever compares against
  // and joins them, and the publish compile reads nothing outside its
  // virtual file system.
  "define": {
    "__filename": "\"/in-worker-typescript/typescript.js\"",
    "__dirname": "\"/in-worker-typescript\""
  },

  // The upstream login's public endpoints. Vars rather than secrets because
  // they are neither: they are the two GitHub origins, and having them arrive
  // through the door is what lets a doubled upstream be reached the same way
  // the real one is, with no test-only branch in the deployed worker.
  "vars": {
    "GITHUB_ORIGIN": "https://github.com",
    "GITHUB_API_ORIGIN": "https://api.github.com",
    // How long the host waits on a run before abandoning it. Configuration
    // through the door, so the tests wait milliseconds where production waits
    // seconds without a test-only code path in the deployed worker.
    "EXECUTE_TIMEOUT_MS": "10000",
    // The daily ceilings, per owner, UTC days: the runaway backstop and no
    // more. The tests override these down to trip them for real.
    "EXECUTION_BUDGET": "500",
    "FETCH_BUDGET": "5000",
    // Hosts exempt from the https-only rule for credentialed requests.
    // Empty in production, always: the tests point this at the loopback
    // listener because no local double can ever be https on port 443. An
    // entry appearing here is an alarm, not a feature.
    "GATEWAY_INSECURE_HOSTS": ""
  },

  // Pre-authentication state: the OAuth provider's own grant state, and the
  // mapping from an upstream identity to an owner id. Both are keyed by
  // something other than the owner because the grant is how the owner is
  // learned, which is the exception the spec carves out by name.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "431d14eada56489b9602cf650efed706"
    }
  ],

  // Two durable objects per owner. The vault holds the credential store, the
  // host policy and the daily counters - the secrets object. The store holds
  // run records, package state and storage data - the work object. Separate
  // classes so the busiest surface has no call path into the most sensitive
  // one. A deploy of this script restarts both; neither keeps memory state.
  "durable_objects": {
    "bindings": [
      { "name": "OWNER_VAULT", "class_name": "OwnerVault" },
      { "name": "OWNER_STORE", "class_name": "OwnerStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OwnerVault"] },
    { "tag": "v2", "new_sqlite_classes": ["OwnerStore"] }
  ]
}
